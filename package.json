{
  "name": "trendmaker-ai-agent",
  "version": "1.0.0",
  "description": "A lightweight Gemini-powered assistant for planning YouTube video research.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "workflow": "tsx src/execute/test-clip-selector.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.js",
    "mcp:youtube": "node dist/mcp/youtube-server.js"
  },
  "keywords": [
    "gemini",
    "youtube",
    "research",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
